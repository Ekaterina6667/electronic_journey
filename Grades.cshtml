                    </div>
                }
                else
                {
                    <div class="alert alert-info">
                        <i class="fas fa-info-circle me-2"></i>
                        В выбранной четверти нет занятий
                    </div>
                }
            }
            else
{
    <!-- ВКЛАДКА 2: Итоговые оценки -->
    <!-- Фильтры для итоговых оценок -->
    <div class="card card-gray mb-4">
        <div class="card-header bg-white">
            <h5 class="mb-0"><i class="fas fa-filter me-2 text-primary"></i>Фильтры</h5>
        </div>
        <div class="card-body">
            <form method="get" class="row g-3">
                <input type="hidden" name="showCurrent" value="false" />
                <div class="col-md-4">
                    <label class="form-label">Группа</label>
                    <select name="groupId" class="form-select" onchange="this.form.submit()">
                        @foreach (var group in Model.Groups)
                        {
                            <option value="@group.Id" selected="@(group.Id == Model.SelectedGroupId)">
                                @group.GroupName
                            </option>
                        }
                    </select>
                </div>
                <div class="col-md-4">
                    <label class="form-label">Предмет</label>
                    <select name="subjectId" class="form-select" onchange="this.form.submit()">
                        @foreach (var subject in Model.Subjects)
                        {
                            <option value="@subject.Id" selected="@(subject.Id == Model.SelectedSubjectId)">
                                @subject.SubjectName
                            </option>
                        }
                    </select>
                </div>
                <div class="col-md-4">
                    <label class="form-label">Учебный год</label>
                    <select name="academicYearId" class="form-select" onchange="this.form.submit()">
                        @foreach (var year in Model.AcademicYears)
                        {
                            <option value="@year.Id" selected="@(year.Id == Model.SelectedAcademicYearId)">
                                @year.Name
                            </option>
                        }
                    </select>
                </div>
            </form>
        </div>
    </div>

    @if (Model.FinalGrades != null && Model.FinalGrades.Any())
    {
        <!-- Информация о выбранных фильтрах -->
        <div class="alert alert-info mb-4">
            <i class="fas fa-info-circle me-2"></i>
            <strong>@Model.GroupName</strong> - <strong>@Model.SubjectName</strong> - <strong>@Model.AcademicYearName</strong>
        </div>

        <!-- Таблица итоговых оценок -->
        <div class="card card-gray">
            <div class="card-body p-0">
                <div class="table-wrapper" style="overflow-x: auto;">
                    <table class="table table-bordered grades-table mb-0">
                        <thead>
                            <tr>
                                <th style="min-width: 250px;">Ученик</th>
                                @{
                                    // Получаем четверти, отсортированные по дате (от 1-й до 4-й)
                                    var sortedQuarters = Model.Quarters
                                        .Where(q => q.StartDate.Year >= (Model.SelectedAcademicYearId.HasValue ? 
                                            Model.AcademicYears.FirstOrDefault(y => y.Id == Model.SelectedAcademicYearId)?.StartYear ?? 0 : 0))
                                        .OrderBy(q => q.StartDate)
                                        .ToList();
                                }
                                @foreach (var quarter in sortedQuarters)
                                {
                                    <th class="text-center" style="min-width: 100px;">
                                        <div>@quarter.Name</div>
                                        <small class="text-muted">@quarter.StartDate.ToString("dd.MM")-@quarter.EndDate.ToString("dd.MM")</small>
                                    </th>
                                }
                                <th class="text-center" style="min-width: 80px;">Год</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var student in Model.FinalGrades)
                            {
                                // Проверяем, все ли четверти заполнены у ученика
                                var allQuartersHaveGrades = student.QuarterGrades.Values.All(g => g.HasValue);
                                
                                <tr>
                                    <td class="fw-bold">@student.StudentName</td>
                                    @foreach (var quarter in sortedQuarters)
                                    {
                                        var grade = student.QuarterGrades.ContainsKey(quarter.Id) ? student.QuarterGrades[quarter.Id] : null;
                                        var isCompleted = student.QuarterCompleted.ContainsKey(quarter.Id) && student.QuarterCompleted[quarter.Id];
                                        
                                        <td class="text-center">
                                            @if (grade.HasValue)
                                            {
                                                <span class="grade-value @(grade >= 4 ? "grade-good" : grade >= 3 ? "grade-ok" : "grade-bad") 
                                                       @(isCompleted ? "" : "grade-pending")"
                                                      title="@(isCompleted ? "Четверть завершена" : "Четверть в процессе")">
                                                    @grade.Value.ToString("F1")
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="grade-value grade-empty" title="Нет оценок">-</span>
                                            }
                                        </td>
                                    }
                                    <td class="text-center">
                                        @if (student.YearGrade.HasValue)
                                        {
                                            <span class="grade-value @(student.YearGrade >= 4 ? "grade-good" : student.YearGrade >= 3 ? "grade-ok" : "grade-bad")
                                                   @(allQuartersHaveGrades ? "" : "grade-pending")"
                                                  title="@(allQuartersHaveGrades ? "Все четверти заполнены" : "Не все четверти заполнены")">
                                                @student.YearGrade.Value.ToString("F1")
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="grade-value grade-empty">-</span>
                                    }
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- Легенда для итоговых оценок -->
        <div class="mt-3 d-flex flex-wrap gap-3">
            <div><span class="badge bg-success">5, 4</span> - хорошие оценки</div>
            <div><span class="badge bg-warning">3</span> - удовлетворительно</div>
            <div><span class="badge bg-danger">2</span> - плохо</div>
            <div><span class="badge bg-secondary opacity-50">серая</span> - четверть не завершена / не все четверти заполнены</div>
        </div>
    }
    else
    {
        <div class="alert alert-info">
            <i class="fas fa-info-circle me-2"></i>
            Нет данных для отображения итоговых оценок
        </div>
    }
}
        </div>
    </div>
</div>
<!-- Модальные окна для работы с оценками (ДОЛЖНЫ БЫТЬ ЗДЕСЬ, вне всех блоков) -->
<!-- Модальное окно для выбора действия с оценкой -->
<div class="modal fade" id="gradeActionModal" tabindex="-1" aria-hidden="true">
