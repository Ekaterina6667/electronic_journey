@* @model MusicSchoolJournal.Models.TeacherGradesViewModel

@{
    ViewData["Title"] = "Оценки";
    var fullName = Model.TeacherName;
    var scheduleId = Model.ScheduleId;
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />

<div class="container-fluid">
    <div class="row">
        <!-- Левое меню (ТОЧНО КАК НА ГЛАВНОЙ) -->
        <div class="col-md-4 col-lg-3 px-0 bg-light min-vh-100 border-end admin-sidebar">
            <div class="p-3">
                <div class="text-center mb-3">
                    <i class="fas fa-music fa-2x text-primary"></i>
                    <h5 class="mt-1">Музыкальная школа</h5>
                    <span class="badge bg-info mt-1 admin-badge">Учитель</span>
                </div>

                <div class="nav flex-column nav-pills">
                    <a class="nav-link py-2 @(ViewContext.RouteData.Values["action"]?.ToString() == "Index" ? "active" : "text-dark")"
                       asp-controller="Teacher" asp-action="Index">
                        <i class="fas fa-home me-3"></i>Главная
                    </a>
                    <a class="nav-link py-2 @(ViewContext.RouteData.Values["action"]?.ToString() == "Schedule" ? "active" : "text-dark")"
                       asp-controller="Teacher" asp-action="Schedule">
                        <i class="fas fa-calendar-alt me-3"></i>Расписание
                    </a>
                    <a class="nav-link py-2 active"
                       asp-controller="Teacher" asp-action="Grades">
                        <i class="fas fa-star me-3"></i>Оценки
                    </a>
                    <a class="nav-link py-2 @(ViewContext.RouteData.Values["action"]?.ToString() == "Homework" ? "active" : "text-dark")"
                       asp-controller="Teacher" asp-action="Homework">
                        <i class="fas fa-book me-3"></i>Домашние задания
                    </a>
                    <a class="nav-link py-2 @(ViewContext.RouteData.Values["action"]?.ToString() == "TeacherIndex" ? "active" : "text-dark")"
                       asp-controller="Advertisements" asp-action="TeacherIndex">
                        <i class="fas fa-bullhorn me-3"></i>Объявления
                    </a>
                    <a class="nav-link py-2 @(ViewContext.RouteData.Values["action"]?.ToString() == "Profile" ? "active" : "text-dark")"
                       asp-controller="Teacher" asp-action="Profile">
                        <i class="fas fa-user me-3"></i>Личный кабинет
                    </a>
                </div>

                <hr class="my-2">

                <div class="user-info mb-2 py-2">
                    <i class="fas fa-user-circle me-2 text-primary"></i>
                    <span class="fw-bold small">@fullName</span>
                </div>

                <form asp-controller="Account" asp-action="Logout" method="post">
                    <button type="submit" class="btn btn-outline-danger w-100 py-2">
                        <i class="fas fa-sign-out-alt me-2"></i>Выйти
                    </button>
                </form>
            </div>
        </div>

        <!-- Правая часть (контент) -->
        <div class="col-md-8 col-lg-9 p-4">
            <!-- Заголовок и фильтры -->
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h2><i class="fas fa-star me-2 text-primary"></i>Оценки</h2>
                <div class="text-muted">
                    <i class="fas fa-calendar me-2"></i>@DateTime.Now.ToString("dd MMMM yyyy")
                </div>
            </div>

            <!-- Фильтры -->
            <div class="card card-gray mb-4">
                <div class="card-header bg-white">
                    <h5 class="mb-0"><i class="fas fa-filter me-2 text-primary"></i>Фильтры</h5>
                </div>
                <div class="card-body">
                    <form method="get" class="row g-3">
                        <div class="col-md-4">
                            <label class="form-label">Группа</label>
                            <select name="groupId" class="form-select" onchange="this.form.submit()">
                                @foreach (var group in Model.Groups)
                                {
                                    <option value="@group.Id" selected="@(group.Id == Model.SelectedGroupId)">
                                        @group.GroupName
                                    </option>
                                }
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Предмет</label>
                            <select name="subjectId" class="form-select" onchange="this.form.submit()">
                                @foreach (var subject in Model.Subjects)
                                {
                                    <option value="@subject.Id" selected="@(subject.Id == Model.SelectedSubjectId)">
                                        @subject.SubjectName
                                    </option>
                                }
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Четверть</label>
                            <select name="quarterId" class="form-select" onchange="this.form.submit()">
                                @foreach (var quarter in Model.Quarters)
                                {
                                    <option value="@quarter.Id" selected="@(quarter.Id == Model.SelectedQuarterId)">
                                        @quarter.Name
                                    </option>
                                }
                            </select>
                        </div>
                    </form>
                </div>
            </div>

            @if (Model.StudentGrades.Any() && Model.Dates.Any())
            {
                <!-- Информация о выбранных фильтрах -->
                <div class="alert alert-info mb-4">
                    <i class="fas fa-info-circle me-2"></i>
                    <strong>@Model.GroupName</strong> - <strong>@Model.SubjectName</strong> - <strong>@Model.QuarterName</strong>
                </div>

                <!-- Таблица оценок -->
                <div class="card card-gray">
                    <div class="card-body p-0">
                        <div class="table-wrapper" style="position: relative; overflow-x: auto;">
                            <table class="table table-bordered grades-table mb-0" style="min-width: 100%; border-collapse: separate; border-spacing: 0;">
                                <thead>
                                    <tr>
                                        <th class="sticky-col" style="min-width: 200px; background-color: #f8f9fa; position: sticky; left: 0; z-index: 20; border-right: 2px solid #dee2e6;">Ученик</th>
                                        <th class="sticky-col-2" style="min-width: 80px; background-color: #f8f9fa; position: sticky; left: 200px; z-index: 20; border-right: 2px solid #dee2e6;">Ср. балл</th>
                                        @foreach (var date in Model.Dates)
                                        {
                                            <th class="text-center date-column" style="min-width: 100px; background-color: #f8f9fa;">
                                                <div>@date.ToString("dd.MM")</div>
                                                <small class="text-muted">@date.ToString("ddd")</small>
                                            </th>
                                        }
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var student in Model.StudentGrades)
                                    {
                                        <tr>
                                            <td class="fw-bold sticky-col" style="position: sticky; left: 0; background-color: white; z-index: 10; border-right: 2px solid #dee2e6;">@student.StudentName</td>
                                            <td class="sticky-col-2 text-center fw-bold @(student.AverageGrade >= 4 ? "text-success" : student.AverageGrade >= 3 ? "text-warning" : "text-danger")"
                                                style="position: sticky; left: 200px; background-color: white; z-index: 10; border-right: 2px solid #dee2e6;">
                                                @student.AverageGrade
                                            </td>
                                            @foreach (var date in Model.Dates)
                                            {
                                                var grades = student.AllGradesByDate.ContainsKey(date) ? student.AllGradesByDate[date] : new List<int>();
                                                <td class="text-center grade-cell" data-student="@student.StudentId" data-date="@date.ToString("yyyy-MM-dd")">
                                                    @if (grades.Any())
                                                    {
                                                        <div class="multiple-grades">
                                                            @foreach (var grade in grades)
                                                            {
                                                                <span class="grade-value @(grade >= 4 ? "grade-good" : grade >= 3 ? "grade-ok" : "grade-bad") editable-grade me-1"
                                                                      onclick="editGrade(this, @student.StudentId, '@date.ToString("yyyy-MM-dd")', @grade)">
                                                                    @grade
                                                                </span>
                                                            }
                                                            <span class="grade-value grade-empty editable-grade"
                                                                  onclick="editGrade(this, @student.StudentId, '@date.ToString("yyyy-MM-dd")', null)">
                                                                +
                                                            </span>
                                                        </div>
                                                    }
                                                    else
                                                    {
                                                        <span class="grade-value grade-empty editable-grade"
                                                              onclick="editGrade(this, @student.StudentId, '@date.ToString("yyyy-MM-dd")', null)">
                                                            +
                                                        </span>
                                                    }
                                                </td>
                                            }
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

                <!-- Легенда -->
                <div class="mt-3 d-flex flex-wrap gap-3">
                    <div><span class="badge bg-success">5, 4</span> - хорошие оценки</div>
                    <div><span class="badge bg-warning">3</span> - удовлетворительно</div>
                    <div><span class="badge bg-danger">2</span> - плохо</div>
                    <div><span class="badge bg-secondary">+</span> - поставить оценку</div>
                </div>
            }
            else if (!Model.Groups.Any() || !Model.Subjects.Any())
            {
                <div class="alert alert-warning">
                    <i class="fas fa-exclamation-triangle me-2"></i>
                    У вас нет назначенных групп или предметов
                </div>
            }
            else
            {
                <div class="alert alert-info">
                    <i class="fas fa-info-circle me-2"></i>
                    В выбранной четверти нет занятий
                </div>
            }
        </div>
    </div>
</div>

<!-- Модальное окно для ввода оценки -->
<div class="modal fade" id="gradeModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-sm">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">
                    <i class="fas fa-star me-2 text-primary"></i>Ввод оценки
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="currentStudentId" />
                <input type="hidden" id="currentDate" />
                <div class="mb-3">
                    <label class="form-label">Оценка</label>
                    <select id="gradeSelect" class="form-select">
                        <option value="">-- Выберите оценку --</option>
                        <option value="5">5 (Отлично)</option>
                        <option value="4">4 (Хорошо)</option>
                        <option value="3">3 (Удовлетворительно)</option>
                        <option value="2">2 (Неудовлетворительно)</option>
                    </select>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Отмена</button>
                <button type="button" class="btn btn-primary" onclick="saveGrade()">Сохранить</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let currentElement;
        let currentStudentId;
        let currentDateStr;

        function editGrade(element, studentId, dateStr, currentGrade) {
            currentElement = element;
            currentStudentId = studentId;
            currentDateStr = dateStr;

            document.getElementById('currentStudentId').value = studentId;
            document.getElementById('currentDate').value = dateStr;

            if (currentGrade) {
                document.getElementById('gradeSelect').value = currentGrade;
            } else {
                document.getElementById('gradeSelect').value = '';
            }

            var modal = new bootstrap.Modal(document.getElementById('gradeModal'));
            modal.show();
        }
        function getAntiForgeryToken() {
            var token = document.querySelector('input[name="__RequestVerificationToken"]');
            return token ? token.value : '';
        }

        function saveGrade() {
            var studentId = currentStudentId;
            var dateStr = currentDateStr;
            var gradeValue = document.getElementById('gradeSelect').value;

            if (!gradeValue) {
                alert('Выберите оценку');
                return;
            }

            var scheduleId = @scheduleId;

            console.log('Сохранение оценки:', {
                studentId: studentId,
                dateStr: dateStr,
                gradeValue: gradeValue,
                scheduleId: scheduleId
            });

            // Сначала получаем или создаем lessonId
            fetch('/Teacher/GetOrCreateLesson?scheduleId=' + scheduleId + '&date=' + encodeURIComponent(dateStr), {
                method: 'GET',
                headers: {
                    'Content-Type': 'application/json'
                }
            })
                .then(response => {
                    if (!response.ok) {
                        throw new Error('Network response was not ok: ' + response.status);
                    }
                    return response.json();
                })
                .then(data => {
                    console.log('Получен lessonId:', data);

                    if (!data.success) {
                        throw new Error(data.message || 'Ошибка при создании занятия');
                    }

                    var formData = new URLSearchParams();
                    formData.append('studentId', studentId);
                    formData.append('lessonId', data.lessonId);
                    formData.append('gradeValue', gradeValue);
                    formData.append('__RequestVerificationToken', getAntiForgeryToken());

                    // Сохраняем оценку
                    return fetch('/Teacher/SaveGrade', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/x-www-form-urlencoded',
                        },
                        body: formData.toString()
                    });
                })
                .then(response => {
                    if (!response.ok) {
                        throw new Error('Network response was not ok: ' + response.status);
                    }
                    return response.json();
                })
                .then(data => {
                    console.log('Результат сохранения:', data);

                    if (data.success) {
                        if (currentElement) {
                            currentElement.innerText = gradeValue;
                            currentElement.className = 'grade-value ' + getGradeClass(gradeValue) + ' editable-grade';
                        }

                        var modal = bootstrap.Modal.getInstance(document.getElementById('gradeModal'));
                        modal.hide();

                        alert('Оценка успешно сохранена');
                        location.reload();
                    } else {
                        alert('Ошибка: ' + data.message);
                    }
                })
                .catch(error => {
                    console.error('Error:', error);
                    alert('Произошла ошибка при сохранении: ' + error.message);
                });
        }
        function getGradeClass(grade) {
            grade = parseInt(grade);
            if (grade >= 4) return 'grade-good';
            if (grade >= 3) return 'grade-ok';
            return 'grade-bad';
        }
    </script>
}

