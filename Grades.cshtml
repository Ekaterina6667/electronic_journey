                        <i class="fas fa-edit me-2"></i>Текущие оценки
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @(!Model.ShowCurrentGrades ? "active" : "")"
                       asp-action="Grades"
                       asp-route-showCurrent="false"
                       asp-route-groupId="@Model.SelectedGroupId"
                       asp-route-subjectId="@Model.SelectedSubjectId"
                       asp-route-academicYearId="@Model.SelectedAcademicYearId">
                        <i class="fas fa-chart-line me-2"></i>Итоговые оценки
                    </a>
                </li>
            </ul>

            @if (Model.ShowCurrentGrades)
            {
                <!-- ВКЛАДКА 1: Текущие оценки -->
