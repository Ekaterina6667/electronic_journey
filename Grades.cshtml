@section Scripts {
    <script>
        // Обновленный JavaScript код
        let currentElement;
        let currentStudentId;
        let currentDateStr;
        let currentGradeId;
        let currentGradeValue;
        function editGrade(element, studentId, dateStr, currentGrade) {
            currentElement = element;
            currentStudentId = studentId;
            currentDateStr = dateStr;
            currentGradeValue = currentGrade;

            if (currentGrade) {
                // Существующая оценка - показываем меню действий
                document.getElementById('currentGradeValueDisplay').innerText = currentGrade;
                var actionModal = new bootstrap.Modal(document.getElementById('gradeActionModal'));
                actionModal.show();
            } else {
                // Новая оценка - показываем окно ввода
                document.getElementById('currentStudentId').value = studentId;
                document.getElementById('currentDate').value = dateStr;
                document.getElementById('gradeSelect').value = '';

                var modal = new bootstrap.Modal(document.getElementById('gradeModal'));
                modal.show();
            }
        }
        function showEditModal() {
            // Закрываем окно выбора действия
            bootstrap.Modal.getInstance(document.getElementById('gradeActionModal')).hide();

            // Показываем окно редактирования
            var editModal = new bootstrap.Modal(document.getElementById('editGradeModal'));
            editModal.show();
        }

        function confirmDelete() {
            // Закрываем окно выбора действия
            bootstrap.Modal.getInstance(document.getElementById('gradeActionModal')).hide();

            // Показываем окно подтверждения удаления
            var deleteModal = new bootstrap.Modal(document.getElementById('deleteGradeModal'));
            deleteModal.show();
        }

        function updateGrade() {
            alert('Функция редактирования временно недоступна');
            bootstrap.Modal.getInstance(document.getElementById('editGradeModal')).hide();
        }

        function deleteGrade() {
            alert('Функция удаления временно недоступна');
            bootstrap.Modal.getInstance(document.getElementById('deleteGradeModal')).hide();
        }
        function showEditModal() {
            bootstrap.Modal.getInstance(document.getElementById('gradeActionModal')).hide();

            document.getElementById('editStudentId').value = currentStudentId;
            document.getElementById('editDate').value = currentDateStr;
            document.getElementById('editGradeId').value = currentGradeId;
            document.getElementById('editGradeSelect').value = currentGradeValue;

            var editModal = new bootstrap.Modal(document.getElementById('editGradeModal'));
            editModal.show();
        }

        function confirmDelete() {
            bootstrap.Modal.getInstance(document.getElementById('gradeActionModal')).hide();
            var deleteModal = new bootstrap.Modal(document.getElementById('deleteGradeModal'));
            deleteModal.show();
        }

        function getAntiForgeryToken() {
            var token = document.querySelector('input[name="__RequestVerificationToken"]');
            return token ? token.value : '';
        }

        function saveGrade() {
            // ... существующий код saveGrade ...
        }

        function updateGrade() {
            var gradeId = document.getElementById('editGradeId').value;
            var gradeValue = document.getElementById('editGradeSelect').value;

            if (!gradeValue) {
                alert('Выберите оценку');
                return;
            }

            var formData = new URLSearchParams();
            formData.append('gradeId', gradeId);
            formData.append('gradeValue', gradeValue);
            formData.append('__RequestVerificationToken', getAntiForgeryToken());

            fetch('/Teacher/UpdateGrade', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded',
                },
                body: formData.toString()
            })
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        if (currentElement) {
                            currentElement.innerText = gradeValue;
                            currentElement.className = 'grade-value ' + getGradeClass(gradeValue) + ' editable-grade';
                        }

                        bootstrap.Modal.getInstance(document.getElementById('editGradeModal')).hide();
                        alert('Оценка успешно обновлена');
                        location.reload();
                    } else {
                        alert('Ошибка: ' + data.message);
                    }
                })
                .catch(error => {
                    console.error('Error:', error);
                    alert('Произошла ошибка при обновлении');
                });
        }

        function deleteGrade() {
            var gradeId = currentGradeId;

            var formData = new URLSearchParams();
            formData.append('gradeId', gradeId);
            formData.append('__RequestVerificationToken', getAntiForgeryToken());

            fetch('/Teacher/DeleteGrade', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded',
                },
                body: formData.toString()
            })
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        bootstrap.Modal.getInstance(document.getElementById('deleteGradeModal')).hide();

                        if (currentElement) {
                            var cell = currentElement.closest('.grade-cell');
                            cell.innerHTML = '<span class="grade-value grade-empty editable-grade" onclick="editGrade(this, ' + currentStudentId + ', \'' + currentDateStr + '\', null)">+</span>';
                        }

                        alert('Оценка успешно удалена');
                    } else {
                        alert('Ошибка: ' + data.message);
                    }
                })
                .catch(error => {
                    console.error('Error:', error);
                    alert('Произошла ошибка при удалении');
                });
        }

        function getGradeClass(grade) {
            grade = parseInt(grade);
            if (grade >= 4) return 'grade-good';
            if (grade >= 3) return 'grade-ok';
            return 'grade-bad';
        }
    </script>
}

