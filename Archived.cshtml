@model IEnumerable<MusicSchoolJournal.Models.User>

@{
    ViewData["Title"] = "Архив учителей";

    // Получаем полное имя из claims или используем значение по умолчанию
    var fullName = User.FindFirst("FullName")?.Value ??
                   User.FindFirst(System.Security.Claims.ClaimTypes.GivenName)?.Value ??
                   "Администратор";
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />

<div class="container-fluid">
    <div class="row">
        <!-- Левое меню (ТОЧНО КАК НА ГЛАВНОЙ) -->
        <div class="col-md-4 col-lg-3 px-0 bg-light min-vh-100 border-end admin-sidebar">
            <div class="p-3">
                <div class="text-center mb-3">
                    <i class="fas fa-music fa-2x text-primary"></i>
                    <h5 class="mt-1">Музыкальная школа</h5>
                    <span class="badge bg-danger mt-1 admin-badge">Администратор</span>
                </div>

                <div class="nav flex-column nav-pills">
                    <a class="nav-link py-2 @(ViewContext.RouteData.Values["controller"]?.ToString() == "Home" ? "active" : "text-dark")"
                       asp-controller="Home" asp-action="Index">
                        <i class="fas fa-home me-3"></i>Главная
                    </a>
                    <a class="nav-link py-2 @(ViewContext.RouteData.Values["controller"]?.ToString() == "Schedule" ? "active" : "text-dark")"
                       asp-controller="Schedule" asp-action="Index">
                        <i class="fas fa-calendar-alt me-3"></i>Расписание
                    </a>
                    <a class="nav-link py-2 active"
                       asp-controller="Teachers" asp-action="Index">
                        <i class="fas fa-chalkboard-teacher me-3"></i>Учителя
                    </a>
                    <a class="nav-link py-2 @(ViewContext.RouteData.Values["controller"]?.ToString() == "Students" ? "active" : "text-dark")"
                       asp-controller="Students" asp-action="Index">
                        <i class="fas fa-user-graduate me-3"></i>Ученики
                    </a>
                    <a class="nav-link py-2 @(ViewContext.RouteData.Values["controller"]?.ToString() == "Groups" ? "active" : "text-dark")"
                       asp-controller="Groups" asp-action="Index">
                        <i class="fas fa-users me-3"></i>Группы
                    </a>
                    <a class="nav-link py-2 @(ViewContext.RouteData.Values["controller"]?.ToString() == "Subjects" ? "active" : "text-dark")"
                       asp-controller="Subjects" asp-action="Index">
                        <i class="fas fa-book me-3"></i>Предметы
                    </a>
                    <a class="nav-link py-2 @(ViewContext.RouteData.Values["controller"]?.ToString() == "Offices" ? "active" : "text-dark")"
                       asp-controller="Offices" asp-action="Index">
                        <i class="fas fa-door-open me-3"></i>Кабинеты
                    </a>
                    <a class="nav-link py-2 @(ViewContext.RouteData.Values["controller"]?.ToString() == "LessonTimes" ? "active" : "text-dark")"
                       asp-controller="LessonTimes" asp-action="Index">
                        <i class="fas fa-clock me-3"></i>Учебные часы
                    </a>
                    <a class="nav-link py-2 @(ViewContext.RouteData.Values["action"]?.ToString() == "AdminIndex" ? "active" : "text-dark")"
                       asp-controller="Advertisements" asp-action="AdminIndex">
                        <i class="fas fa-bullhorn me-3"></i>Объявления
                    </a>
                    <a class="nav-link py-2 @(ViewContext.RouteData.Values["controller"]?.ToString() == "AcademicQuarters" ? "active" : "text-dark")"
                       asp-controller="AcademicQuarters" asp-action="Index">
                        <i class="fas fa-calendar-week me-3"></i>Четверти
                    </a>
                    <a class="nav-link py-2 @(ViewContext.RouteData.Values["controller"]?.ToString() == "Account" ? "active" : "text-dark")"
                       asp-controller="Account" asp-action="Profile">
                        <i class="fas fa-user me-3"></i>Личный кабинет
                    </a>
                </div>

                <hr class="my-2">

                <div class="user-info mb-2 py-2">
                    <i class="fas fa-user-circle me-2 text-primary"></i>
                    <span class="fw-bold small">Шамшурин Николай Анатольевич</span>
                </div>

                <form asp-controller="Account" asp-action="Logout" method="post">
                    <button type="submit" class="btn btn-outline-danger w-100 py-2">
                        <i class="fas fa-sign-out-alt me-2"></i>Выйти
                    </button>
                </form>
            </div>
        </div>

        <!-- Правая часть (контент) -->
        <div class="col-md-8 col-lg-9 p-4">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h2 class="page-title"><i class="fas fa-archive me-2 text-secondary"></i>Архив учителей</h2>
                <a asp-action="Index" class="btn btn-outline-secondary">
                    <i class="fas fa-arrow-left me-2"></i>К списку учителей
                </a>
            </div>

            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show py-2 mb-3 position-relative" role="alert" id="successAlert">
                    <div class="d-flex align-items-center">
                        <i class="fas fa-check-circle me-2"></i>
                        <span>@TempData["Success"]</span>
                        <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close" style="position: relative; padding: 0.25rem;"></button>
                    </div>
                </div>
            }

            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show py-2 mb-3 position-relative" role="alert" id="errorAlert">
                    <div class="d-flex align-items-center">
                        <i class="fas fa-exclamation-circle me-2"></i>
                        <span>@TempData["Error"]</span>
                        <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close" style="position: relative; padding: 0.25rem;"></button>
                    </div>
                </div>
            }

            @if (!Model.Any())
            {
                <div class="alert alert-info py-2 mb-0">
                    <i class="fas fa-info-circle me-2"></i>Архив пуст
                </div>
            }
            else
            {
                <div class="card card-gray">
                    <div class="card-body p-3">
                        <div class="table-responsive">
                            <table class="table table-hover mb-0">
                                <thead>
                                    <tr>
                                        <th>ФИО</th>
                                        <th>Телефон</th>
                                        <th>Email</th>
                                        <th>Предметы</th>
                                        <th>Дата архивации</th>
                                        <th class="text-end">Действия</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var teacher in Model)
                                    {
                                        <tr>
                                            <td class="align-middle">
                                                <strong>@teacher.LastName @teacher.FirstName @teacher.MiddleName</strong>
                                            </td>
                                            <td class="align-middle">@teacher.PhoneNumber</td>
                                            <td class="align-middle">@teacher.Email</td>
                                            <td class="align-middle">
                                                @if (teacher.TeacherSpecializations != null && teacher.TeacherSpecializations.Any())
                                                {
                                                    var subjects = string.Join(", ", teacher.TeacherSpecializations.Select(ts => ts.Subject?.SubjectName));
                                                    <span>@subjects</span>
                                                }
                                                else
                                                {
                                                    <span class="text-muted fst-italic">Не указаны</span>
                                                }
                                            </td>
                                            <td class="align-middle">
                                                @(teacher.ArchivedAt?.ToString("dd.MM.yyyy") ?? "-")
                                            </td>
                                            <td class="text-end align-middle" style="white-space: nowrap;">
                                                <form asp-action="Restore" asp-route-id="@teacher.Id" method="post" class="d-inline me-2">
                                                    <button type="submit" class="btn btn-sm btn-success" title="Восстановить">
                                                        <i class="fas fa-undo"></i>
                                                    </button>
                                                </form>
                                                <form asp-action="PermanentDelete" asp-route-id="@teacher.Id" method="post" class="d-inline"
                                                      onsubmit="return confirm('Вы уверены, что хотите полностью удалить учителя @teacher.LastName @teacher.FirstName? Это действие необратимо!');">
                                                    <button type="submit" class="btn btn-sm btn-danger" title="Удалить навсегда">
                                                        <i class="fas fa-trash"></i>
                                                    </button>
                                                </form>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Автоматическое скрытие сообщений через 2 секунды
        setTimeout(function () {
            var successAlert = document.getElementById('successAlert');
            var errorAlert = document.getElementById('errorAlert');

            if (successAlert) {
                var bsAlert = new bootstrap.Alert(successAlert);
                bsAlert.close();
            }

            if (errorAlert) {
                var bsAlert = new bootstrap.Alert(errorAlert);
                bsAlert.close();
            }
        }, 2000);
    </script>
}

<style>
    /* Стили для левой панели администратора - ТОЧНО КАК НА ГЛАВНОЙ */
    .admin-sidebar {
        min-width: 260px;
    }

        .admin-sidebar .nav-link {
            border-radius: 8px;
            margin-bottom: 2px;
            transition: all 0.2s;
            white-space: nowrap;
            padding: 8px 12px;
            font-size: 0.95rem;
        }

            .admin-sidebar .nav-link i {
                width: 22px;
                text-align: center;
                font-size: 1rem;
            }

            .admin-sidebar .nav-link:hover:not(.active) {
                background-color: #e9ecef;
            }

            .admin-sidebar .nav-link.active {
                background-color: #0d6efd;
                color: white !important;
            }

    .admin-badge {
        font-size: 0.8rem !important;
        padding: 4px 8px !important;
        display: inline-block;
    }

    .user-info {
        font-size: 0.9rem;
        padding: 8px 10px;
        background-color: #f8f9fa;
        border-radius: 8px;
        border-left: 3px solid #0d6efd;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .min-vh-100 {
        min-height: 100vh;
    }

    /* Уменьшенные отступы - КАК НА ГЛАВНОЙ */
    .py-2 {
        padding-top: 0.4rem !important;
        padding-bottom: 0.4rem !important;
    }

    .my-2 {
        margin-top: 0.5rem !important;
        margin-bottom: 0.5rem !important;
    }

    .mb-2 {
        margin-bottom: 0.5rem !important;
    }

    .mb-3 {
        margin-bottom: 0.8rem !important;
    }

    hr {
        margin-top: 0.5rem;
        margin-bottom: 0.5rem;
        opacity: 0.3;
    }

    /* Стили для правой части */
    .page-title {
        font-size: 2.5rem;
        font-weight: 300;
        margin-bottom: 0;
    }

    .card-gray {
        background-color: #e9ecef !important;
        border: none;
        border-radius: 12px;
    }

    .card {
        border-radius: 12px;
        overflow: hidden;
    }

    .btn-sm {
        padding: 0.25rem 0.75rem;
        font-size: 0.85rem;
    }

    /* Размеры колонок */
    .col-md-4 {
        flex: 0 0 auto;
        width: 33.33333333%;
    }

    .col-lg-3 {
        flex: 0 0 auto;
        width: 25%;
    }

    .col-md-8 {
        flex: 0 0 auto;
        width: 66.66666667%;
    }

    .col-lg-9 {
        flex: 0 0 auto;
        width: 75%;
    }
</style>