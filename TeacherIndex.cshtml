@model IEnumerable<MusicSchoolJournal.Models.Advertisement>

@{
    ViewData["Title"] = "Объявления";
    var fullName = ViewBag.TeacherFullName ?? User.FindFirst(System.Security.Claims.ClaimTypes.GivenName)?.Value ?? "Учитель";
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />

<div class="container-fluid">
    <div class="row">
        <!-- Левое меню (ТОЧНО КАК НА ГЛАВНОЙ) -->
        <div class="col-md-4 col-lg-3 px-0 bg-light min-vh-100 border-end admin-sidebar">
            <div class="p-3">
                <div class="text-center mb-3">
                    <i class="fas fa-music fa-2x text-primary"></i>
                    <h5 class="mt-1">Музыкальная школа</h5>
                    <span class="badge bg-info mt-1 admin-badge">Учитель</span>
                </div>

                <div class="nav flex-column nav-pills">
                    <a class="nav-link py-2 @(ViewContext.RouteData.Values["action"]?.ToString() == "Index" ? "active" : "text-dark")"
                       asp-controller="Teacher" asp-action="Index">
                        <i class="fas fa-home me-3"></i>Главная
                    </a>
                    <a class="nav-link py-2 @(ViewContext.RouteData.Values["action"]?.ToString() == "Schedule" ? "active" : "text-dark")"
                       asp-controller="Teacher" asp-action="Schedule">
                        <i class="fas fa-calendar-alt me-3"></i>Расписание
                    </a>
                    <a class="nav-link py-2 @(ViewContext.RouteData.Values["action"]?.ToString() == "Grades" ? "active" : "text-dark")"
                       asp-controller="Teacher" asp-action="Grades">
                        <i class="fas fa-star me-3"></i>Оценки
                    </a>
                    <a class="nav-link py-2 @(ViewContext.RouteData.Values["action"]?.ToString() == "Homework" ? "active" : "text-dark")"
                       asp-controller="Teacher" asp-action="Homework">
                        <i class="fas fa-book me-3"></i>Домашние задания
                    </a>
                    <a class="nav-link py-2 active"
                       asp-controller="Advertisements" asp-action="TeacherIndex">
                        <i class="fas fa-bullhorn me-3"></i>Объявления
                    </a>
                    <a class="nav-link py-2 @(ViewContext.RouteData.Values["action"]?.ToString() == "Profile" ? "active" : "text-dark")"
                       asp-controller="Teacher" asp-action="Profile">
                        <i class="fas fa-user me-3"></i>Личный кабинет
                    </a>
                </div>

                <hr class="my-2">

                <div class="user-info mb-2 py-2">
                    <i class="fas fa-user-circle me-2 text-primary"></i>
                    <span class="fw-bold small">@fullName</span>
                </div>

                <form asp-controller="Account" asp-action="Logout" method="post">
                    <button type="submit" class="btn btn-outline-danger w-100 py-2">
                        <i class="fas fa-sign-out-alt me-2"></i>Выйти
                    </button>
                </form>
            </div>
        </div>

        <!-- Правая часть (контент) -->
        <div class="col-md-8 col-lg-9 p-4">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h2><i class="fas fa-bullhorn me-2 text-primary"></i>Объявления</h2>
                <div class="text-muted">
                    <i class="fas fa-calendar me-2"></i>@DateTime.Now.ToString("dd MMMM yyyy")
                </div>
            </div>

            @if (!Model.Any())
            {
                <div class="alert alert-info">
                    <i class="fas fa-info-circle me-2"></i>Нет объявлений
                </div>
            }
            else
            {
                <div class="announcements-list">
                    @foreach (var item in Model)
                    {
                        <div class="card announcement-card mb-4">
                            <div class="card-header">
                                <span class="date-badge">
                                    <i class="far fa-calendar-alt me-1"></i>
                                    @item.PublicationDate.ToString("dd.MM.yyyy HH:mm")
                                </span>
                            </div>
                            <div class="card-body">
                                <p class="card-text announcement-text">@item.Description</p>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</div>

<style>
    /* Стили для левой панели учителя - ТОЧНО КАК НА ГЛАВНОЙ */
    .admin-sidebar {
        min-width: 260px;
    }

        .admin-sidebar .nav-link {
            border-radius: 8px;
            margin-bottom: 2px;
            transition: all 0.2s;
            white-space: nowrap;
            padding: 8px 12px;
            font-size: 0.95rem;
        }

            .admin-sidebar .nav-link i {
                width: 22px;
                text-align: center;
                font-size: 1rem;
            }

            .admin-sidebar .nav-link:hover:not(.active) {
                background-color: #e9ecef;
            }

            .admin-sidebar .nav-link.active {
                background-color: #0d6efd;
                color: white !important;
            }

    .admin-badge {
        font-size: 0.8rem !important;
        padding: 4px 8px !important;
        display: inline-block;
    }

    .user-info {
        font-size: 0.9rem;
        padding: 8px 10px;
        background-color: #f8f9fa;
        border-radius: 8px;
        border-left: 3px solid #0d6efd;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .min-vh-100 {
        min-height: 100vh;
    }

    /* Уменьшенные отступы - КАК НА ГЛАВНОЙ */
    .py-2 {
        padding-top: 0.4rem !important;
        padding-bottom: 0.4rem !important;
    }

    .my-2 {
        margin-top: 0.5rem !important;
        margin-bottom: 0.5rem !important;
    }

    .mb-2 {
        margin-bottom: 0.5rem !important;
    }

    .mb-3 {
        margin-bottom: 0.8rem !important;
    }

    hr {
        margin-top: 0.5rem;
        margin-bottom: 0.5rem;
        opacity: 0.3;
    }

    /* Стили для карточек объявлений */
    .announcement-card {
        border: none;
        border-radius: 12px;
        background-color: #e9ecef;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05);
        transition: all 0.3s ease;
    }

        .announcement-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 16px rgba(0, 0, 0, 0.1);
        }

        .announcement-card .card-header {
            background-color: #e9ecef;
            border-bottom: 1px solid rgba(0, 0, 0, 0.05);
            padding: 16px 20px 8px 20px;
        }

        .announcement-card .card-body {
            background-color: #e9ecef;
            padding: 8px 20px 20px 20px;
        }

    .date-badge {
        display: inline-block;
        font-size: 0.9rem;
        color: #495057;
        background-color: rgba(255, 255, 255, 0.5);
        padding: 4px 12px;
        border-radius: 20px;
        font-weight: 500;
    }

    .announcement-text {
        font-size: 1.1rem;
        line-height: 1.6;
        color: #2c3e50;
        margin-bottom: 0;
        white-space: pre-line;
    }

    .announcements-list {
        max-width: 900px;
        margin: 0 auto;
    }

    /* Размеры колонок */
    .col-md-4 {
        flex: 0 0 auto;
        width: 33.33333333%;
    }

    .col-lg-3 {
        flex: 0 0 auto;
        width: 25%;
    }

    .col-md-8 {
        flex: 0 0 auto;
        width: 66.66666667%;
    }

    .col-lg-9 {
        flex: 0 0 auto;
        width: 75%;
    }
</style>