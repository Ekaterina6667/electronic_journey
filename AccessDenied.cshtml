@{
    ViewData["Title"] = "Доступ запрещен";
    var returnUrl = Context.Request.Query["ReturnUrl"];
}

<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Музыкальная школа</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />
</head>
<body class="bg-light">
    <div class="container mt-5">
        <div class="row justify-content-center">
            <div class="col-md-6">
                <div class="card shadow">
                    <div class="card-header bg-danger text-white">
                        <h4 class="mb-0">
                            <i class="fas fa-exclamation-triangle me-2"></i>Доступ запрещен
                        </h4>
                    </div>
                    <div class="card-body text-center py-5">
                        <i class="fas fa-lock fa-5x text-danger mb-4"></i>
                        <h5 class="mb-3">У вас нет прав для доступа к этой странице.</h5>
                        <p class="text-muted mb-4">
                            Если вы считаете, что это ошибка, обратитесь к администратору системы.
                        </p>
                        @if (!string.IsNullOrEmpty(returnUrl))
                        {
                            <p class="small text-muted mb-4">
                                Запрашиваемый URL: <code>@returnUrl</code>
                            </p>
                        }
                        <div class="d-grid gap-2">
                            <a asp-controller="Home" asp-action="Index" class="btn btn-primary">
                                <i class="fas fa-home me-2"></i>Вернуться на главную
                            </a>
                            <form asp-controller="Account" asp-action="Logout" method="post">
                                <button type="submit" class="btn btn-outline-secondary w-100">
                                    <i class="fas fa-sign-out-alt me-2"></i>Выйти из системы
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</body>
</html>