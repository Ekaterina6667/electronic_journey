@model MusicSchoolJournal.Models.User

@{
    ViewData["Title"] = "Личный кабинет администратора";
    var fullName = $"{Model.LastName} {Model.FirstName} {Model.MiddleName}".Trim();
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />

<div class="container-fluid">
    <div class="row">
   
        <div class="col-md-4 col-lg-3 px-0 bg-light min-vh-100 border-end admin-sidebar">
            <div class="p-3">
                <div class="text-center mb-3">
                    <i class="fas fa-music fa-2x text-primary"></i>
                    <h5 class="mt-1">Музыкальная школа</h5>
                    <span class="badge bg-danger mt-1 admin-badge">Администратор</span>
                </div>

                <div class="nav flex-column nav-pills">
                    <a class="nav-link py-2 @(ViewContext.RouteData.Values["controller"]?.ToString() == "Home" ? "active" : "text-dark")"
                       asp-controller="Home" asp-action="Index">
                        <i class="fas fa-home me-3"></i>Главная
                    </a>
                    <a class="nav-link py-2 @(ViewContext.RouteData.Values["controller"]?.ToString() == "Schedule" ? "active" : "text-dark")"
                       asp-controller="Schedule" asp-action="Index">
                        <i class="fas fa-calendar-alt me-3"></i>Расписание
                    </a>
                    <a class="nav-link py-2 @(ViewContext.RouteData.Values["controller"]?.ToString() == "Teachers" ? "active" : "text-dark")"
                       asp-controller="Teachers" asp-action="Index">
                        <i class="fas fa-chalkboard-teacher me-3"></i>Учителя
                    </a>
                    <a class="nav-link py-2 @(ViewContext.RouteData.Values["controller"]?.ToString() == "Students" ? "active" : "text-dark")"
                       asp-controller="Students" asp-action="Index">
                        <i class="fas fa-user-graduate me-3"></i>Ученики
                    </a>
                    <a class="nav-link py-2 @(ViewContext.RouteData.Values["controller"]?.ToString() == "Groups" ? "active" : "text-dark")"
                       asp-controller="Groups" asp-action="Index">
                        <i class="fas fa-users me-3"></i>Группы
                    </a>
                    <a class="nav-link py-2 @(ViewContext.RouteData.Values["controller"]?.ToString() == "Subjects" ? "active" : "text-dark")"
                       asp-controller="Subjects" asp-action="Index">
                        <i class="fas fa-book me-3"></i>Предметы
                    </a>
                    <a class="nav-link py-2 @(ViewContext.RouteData.Values["controller"]?.ToString() == "Offices" ? "active" : "text-dark")"
                       asp-controller="Offices" asp-action="Index">
                        <i class="fas fa-door-open me-3"></i>Кабинеты
                    </a>
                    <a class="nav-link py-2 @(ViewContext.RouteData.Values["controller"]?.ToString() == "LessonTimes" ? "active" : "text-dark")"
                       asp-controller="LessonTimes" asp-action="Index">
                        <i class="fas fa-clock me-3"></i>Учебные часы
                    </a>
                    <a class="nav-link py-2 @(ViewContext.RouteData.Values["action"]?.ToString() == "AdminIndex" ? "active" : "text-dark")"
                       asp-controller="Advertisements" asp-action="AdminIndex">
                        <i class="fas fa-bullhorn me-3"></i>Объявления
                    </a>
                    <a class="nav-link py-2 @(ViewContext.RouteData.Values["controller"]?.ToString() == "AcademicQuarters" ? "active" : "text-dark")"
                       asp-controller="AcademicQuarters" asp-action="Index">
                        <i class="fas fa-calendar-week me-3"></i>Четверти
                    </a>
                    <a class="nav-link py-2 active"
                       asp-controller="Account" asp-action="Profile">
                        <i class="fas fa-user me-3"></i>Личный кабинет
                    </a>
                </div>

                <hr class="my-2">

                <div class="user-info mb-2 py-2">
                    <i class="fas fa-user-circle me-2 text-primary"></i>
                    <span class="fw-bold small">@fullName</span>
                </div>

                <form asp-controller="Account" asp-action="Logout" method="post">
                    <button type="submit" class="btn btn-outline-danger w-100 py-2">
                        <i class="fas fa-sign-out-alt me-2"></i>Выйти
                    </button>
                </form>
            </div>
        </div>

        <div class="col-md-8 col-lg-9 p-4">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h2><i class="fas fa-user me-2 text-primary"></i>Личный кабинет</h2>
                <span class="text-muted">
                    <i class="fas fa-calendar me-2"></i>@DateTime.Now.ToString("dd MMMM yyyy")
                </span>
            </div>

            <div class="card card-gray mb-4">
                <div class="card-body text-center py-4">
                    <div class="mb-3">
                        <i class="fas fa-user-circle fa-5x text-primary"></i>
                    </div>
                    <h3 class="mb-1">@fullName</h3>
                    <p class="text-muted mb-0">
                        <i class="fas fa-user-shield me-2"></i>Администратор
                    </p>
                </div>
            </div>

            <div class="card card-gray mb-4">
                <div class="card-header bg-white border-bottom d-flex justify-content-between align-items-center">
                    <h5 class="mb-0"><i class="fas fa-address-card me-2 text-primary"></i>Контактная информация</h5>
                    <button class="btn btn-sm btn-outline-primary" data-bs-toggle="modal" data-bs-target="#editProfileModal">
                        <i class="fas fa-edit me-1"></i>Редактировать
                    </button>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6">
                            <table class="table table-borderless">
                                <tr>
                                    <td class="ps-0" style="width: 40px;">
                                        <i class="fas fa-phone text-primary"></i>
                                    </td>
                                    <th class="ps-0" style="width: 100px;">Телефон:</th>
                                    <td class="ps-0 fw-bold">@Model.PhoneNumber</td>
                                </tr>
                                <tr>
                                    <td class="ps-0">
                                        <i class="fas fa-envelope text-primary"></i>
                                    </td>
                                    <th class="ps-0">Email:</th>
                                    <td class="ps-0">@Model.Email</td>
                                </tr>
                            </table>
                        </div>
                        <div class="col-md-6">
                            <table class="table table-borderless">
                                <tr>
                                    <td class="ps-0" style="width: 40px;">
                                        <i class="fas fa-lock text-primary"></i>
                                    </td>
                                    <th class="ps-0" style="width: 100px;">Логин:</th>
                                    <td class="ps-0">@Model.Login</td>
                                </tr>
                                <tr>
                                    <td class="ps-0">
                                        <i class="fas fa-key text-primary"></i>
                                    </td>
                                    <th class="ps-0">Пароль:</th>
                                    <td class="ps-0">
                                        <span class="password-dots">••••••••</span>
                                    </td>
                                </tr>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="editProfileModal" tabindex="-1" aria-labelledby="editProfileModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="editProfileModalLabel">
                    <i class="fas fa-edit me-2 text-primary"></i>Редактирование контактной информации
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form asp-action="UpdateAdminProfile" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Id" />

                    <div class="mb-3">
                        <label class="form-label">
                            <i class="fas fa-phone me-2 text-primary"></i>Телефон
                        </label>
                        <input asp-for="PhoneNumber" class="form-control" placeholder="+7XXXXXXXXXX" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">
                            <i class="fas fa-envelope me-2 text-primary"></i>Email
                        </label>
                        <input asp-for="Email" class="form-control" type="email" placeholder="admin@music.school" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">
                            <i class="fas fa-lock me-2 text-primary"></i>Логин
                        </label>
                        <input asp-for="Login" class="form-control" placeholder="Логин для входа" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">
                            <i class="fas fa-key me-2 text-primary"></i>Новый пароль
                        </label>
                        <input type="password" name="NewPassword" class="form-control" placeholder="Оставьте пустым, если не хотите менять" />
                        <small class="text-muted">Минимум 8 символов</small>
                    </div>

                    <div class="d-grid">
                        <button type="submit" class="btn btn-primary">
                            <i class="fas fa-save me-2"></i>Сохранить изменения
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<style>
    .admin-sidebar {
        min-width: 260px;
    }

        .admin-sidebar .nav-link {
            border-radius: 8px;
            margin-bottom: 2px;
            transition: all 0.2s;
            white-space: nowrap;
            padding: 8px 12px;
            font-size: 0.95rem;
        }

            .admin-sidebar .nav-link i {
                width: 22px;
                text-align: center;
                font-size: 1rem;
            }

            .admin-sidebar .nav-link:hover:not(.active) {
                background-color: #e9ecef;
            }

            .admin-sidebar .nav-link.active {
                background-color: #0d6efd;
                color: white !important;
            }

    .admin-badge {
        font-size: 0.8rem !important;
        padding: 4px 8px !important;
        display: inline-block;
    }

    .user-info {
        font-size: 0.9rem;
        padding: 8px 10px;
        background-color: #f8f9fa;
        border-radius: 8px;
        border-left: 3px solid #0d6efd;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .min-vh-100 {
        min-height: 100vh;
    }

    /* Серый фон для карточек */
    .card-gray {
        background-color: #e9ecef !important;
        border: none;
        border-radius: 12px;
    }

    .card {
        border-radius: 12px;
        overflow: hidden;
    }

    .card-header {
        background-color: white;
        border-bottom: 1px solid #dee2e6;
        padding: 15px 20px;
    }

    .table th, .table td {
        border: none;
    }

    .password-dots {
        font-size: 1.2rem;
        letter-spacing: 2px;
        font-weight: bold;
    }

    /* Уменьшенные отступы */
    .py-2 {
        padding-top: 0.4rem !important;
        padding-bottom: 0.4rem !important;
    }

    .my-2 {
        margin-top: 0.5rem !important;
        margin-bottom: 0.5rem !important;
    }

    hr {
        margin-top: 0.5rem;
        margin-bottom: 0.5rem;
        opacity: 0.3;
    }

    /* Размеры колонок */
    .col-md-4 {
        flex: 0 0 auto;
        width: 33.33333333%;
    }

    .col-lg-3 {
        flex: 0 0 auto;
        width: 25%;
    }

    .col-md-8 {
        flex: 0 0 auto;
        width: 66.66666667%;
    }

    .col-lg-9 {
        flex: 0 0 auto;
        width: 75%;
    }

    /* Стили для модального окна */
    .modal-content {
        border-radius: 12px;
        border: none;
    }

    .modal-header {
        border-bottom: 1px solid #dee2e6;
        padding: 15px 20px;
    }

    .modal-body {
        padding: 20px;
    }

    .form-control {
        border-radius: 8px;
        border: 1px solid #dee2e6;
        padding: 8px 12px;
    }

        .form-control:focus {
            border-color: #4361ee;
            box-shadow: 0 0 0 0.2rem rgba(67, 97, 238, 0.25);
        }
</style>
