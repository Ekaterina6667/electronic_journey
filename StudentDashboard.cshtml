@{
    ViewData["Title"] = "Личный кабинет ученика";
    var userName = User.FindFirst(System.Security.Claims.ClaimTypes.GivenName)?.Value ?? "Ученик";
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />

<div class="container-fluid">
    <div class="row">
        <div class="col-md-3 col-lg-2 px-0 bg-light min-vh-100 border-end">
            <div class="p-3">
                <div class="text-center mb-4">
                    <i class="fas fa-music fa-2x text-primary"></i>
                    <h5 class="mt-2">Музыкальная школа</h5>
                </div>

                <div class="nav flex-column nav-pills">
                    <a class="nav-link active" href="#">
                        <i class="fas fa-home me-2"></i>Главная
                    </a>
                    <a class="nav-link text-dark" href="#">
                        <i class="fas fa-calendar-alt me-2"></i>Расписание
                    </a>
                    <a class="nav-link text-dark" href="#">
                        <i class="fas fa-book me-2"></i>Домашние задания
                    </a>
                    <a class="nav-link text-dark" href="#">
                        <i class="fas fa-star me-2"></i>Оценки
                    </a>
                    <a class="nav-link text-dark" asp-controller="Advertisements" asp-action="Index">
                        <i class="fas fa-bullhorn me-2"></i>Объявления
                    </a>
                    <a class="nav-link text-dark" href="#">
                        <i class="fas fa-user me-2"></i>Личный кабинет
                    </a>
                </div>

                <hr class="my-3">

                <div class="small text-muted mb-2">
                    <i class="fas fa-user-circle me-1"></i> @userName
                </div>

                <form asp-controller="Account" asp-action="Logout" method="post">
                    <button type="submit" class="btn btn-outline-danger w-100">
                        <i class="fas fa-sign-out-alt me-2"></i>Выйти
                    </button>
                </form>
            </div>
        </div>

        <div class="col-md-9 col-lg-10 p-5">
            <div class="text-center mt-5">
                <!-- Приветствие -->
                <h1 class="display-4 mb-4">👋 Здравствуйте, @userName!</h1>

                <!-- Вдохновляющая фраза -->
                <div class="mt-5 pt-5">
                    <i class="fas fa-music fa-4x text-primary opacity-50 mb-3"></i>
                    <p class="lead fst-italic" style="font-size: 2rem; color: #6c757d;">
                        "Пусть музыка наполняет<br>вашу жизнь радостью!"
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .nav-link {
        border-radius: 10px;
        margin-bottom: 5px;
        transition: all 0.3s;
        white-space: nowrap;
    }

        .nav-link:hover:not(.active) {
            background-color: #e9ecef;
        }

        .nav-link.active {
            background-color: #0d6efd;
        }

    .min-vh-100 {
        min-height: 100vh;
    }

    .opacity-50 {
        opacity: 0.5;
    }

    .fst-italic {
        font-style: italic;
    }
</style>
